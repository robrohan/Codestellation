		{"id":"group-langs","type":"group","label":"One box per language folder","x":-40,"y":-60,"width":1320,"height":820},
		{"id":"lang-c","type":"text","text":"## C\n`#include` between .c/.h files\n\nShift+click: [[c]]","x":0,"y":0,"width":280,"height":150,"color":"1"},
